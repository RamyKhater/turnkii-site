# Public origin — used for canonical URLs, Open Graph, sitemap.
# SITE_ORIGIN=https://turnkii.app

# Admin intake endpoint the brief form posts to.
# TURNKII_INTAKE_URL=https://turnkii-admin.vercel.app/api/requests/intake

# Admin content endpoint — the build fetches published hero copy (and other
# content) from here and bakes it into the pages. Leave unset to use the
# built-in defaults committed in the .dc.html files.
# TURNKII_CONTENT_URL=https://turnkii-admin.vercel.app/api/site-content
